{
    // Permite rodar o programa com F5 no VSCode (com depurador).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Gestor de Estoque",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
